# Copy this file to .env (or export these in your shell/systemd unit) before running.
# None of the scripts read .env files directly (stdlib only, no pip deps) -
# export these as real environment variables, e.g.:
#   set -a; source .env; set +a; python3 arr-dashboard.py

SONARR_URL=http://localhost:8989
SONARR_API_KEY=your-sonarr-api-key

RADARR_URL=http://localhost:7878
RADARR_API_KEY=your-radarr-api-key

QBIT_URL=http://localhost:8080
QBIT_USER=admin
QBIT_PASS=your-qbittorrent-password
